# ==============================================================
# TVK MLA Public Service Portal - Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your Firebase project credentials.
# If these variables are not provided, the portal automatically operates
# in a safe, interactive Demo/Simulation mode for immediate testing.

VITE_FIREBASE_API_KEY=AIzaSyYourProjectApiKeyHere1234567890
VITE_FIREBASE_AUTH_DOMAIN=tvk-mla-public-service.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tvk-mla-public-service
VITE_FIREBASE_STORAGE_BUCKET=tvk-mla-public-service.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

